{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch --env=.env src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "worker": "bun --watch --env=.env src/workers/emailWorker.ts",
    "generate:migrations": "npx drizzle-kit generate",
    "apply:migrations": "npx drizzle-kit migrate",
    "generate:types": "drizzle-kit generate:types --config ./drizzle.config.ts --out ./src/lib/db-types.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/express": "^5.0.6",
    "drizzle-kit": "^0.31.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.975.0",
    "@aws-sdk/client-sns": "^3.975.0",
    "@aws-sdk/client-sqs": "^3.974.0",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.0.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "pg": "^8.17.2"
  }
}
